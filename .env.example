# Copia este archivo como .env y rellena los valores reales.
# Obtén estos valores en: Firebase Console → Tu proyecto → Configuración del proyecto.
# NUNCA subas el archivo .env real a git.

FIREBASE_API_KEY=AIzaSy_REPLACE_ME
FIREBASE_APP_ID=1:000000000000:android:REPLACE_ME
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_STORAGE_BUCKET=tu-proyecto-id.firebasestorage.app
FIREBASE_AUTH_DOMAIN=tu-proyecto-id.firebaseapp.com
